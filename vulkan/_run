#!/usr/bin/env bash
# Self-contained launcher: bundled Mesa RADV + libdrm. Max-perf mmid flags on by default,
# including F16B (safe; small win on some MoEs, neutral elsewhere). Disable any with e.g. GGML_VK_MMID_F16B=0.
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
export VK_ICD_FILENAMES="$HERE/driver/radeon_icd.x86_64.json"
export VK_DRIVER_FILES="$VK_ICD_FILENAMES"
export LD_LIBRARY_PATH="$HERE/driver:$HERE/bin${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
: "${GGML_VK_MMID_ROWLISTS:=1}" "${GGML_VK_MMID_SMALLN:=1}" "${GGML_VK_MMID_BM64:=1}" "${GGML_VK_MMID_WAVE32:=1}" "${GGML_VK_MMID_F16B:=1}"
export GGML_VK_MMID_ROWLISTS GGML_VK_MMID_SMALLN GGML_VK_MMID_BM64 GGML_VK_MMID_WAVE32 GGML_VK_MMID_F16B
exec "$HERE/bin/$(basename "$0")" "$@"
