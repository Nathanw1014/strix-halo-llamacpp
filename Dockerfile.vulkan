FROM ubuntu:24.04
LABEL com.github.containers.toolbox="true" \
      org.opencontainers.image.title="strix-halo-fa-vulkan" \
      org.opencontainers.image.description="llama.cpp Vulkan/RADV for Strix Halo (gfx1151), FA + MoE-prefill fixes, bundled Mesa 26.3"
# runtime deps for the bundled RADV, plus a distrobox/toolbox-friendly base so `enter` works offline
RUN apt-get update && apt-get install -y --no-install-recommends \
      libvulkan1 libgomp1 libelf1 libexpat1 libzstd1 ca-certificates \
      bash-completion sudo procps passwd less findutils util-linux ncurses-base curl wget \
    && rm -rf /var/lib/apt/lists/*
COPY vulkan /opt/strix-fa/vulkan
ENV PATH=/opt/strix-fa/vulkan:$PATH
WORKDIR /models
EXPOSE 8080
# App entrypoint for `docker run`. distrobox/toolbox ignore it and open a shell instead, where
# llama-server/llama-cli/llama-bench are on PATH and the wrapper sets the driver + mmid env.
ENTRYPOINT ["/opt/strix-fa/vulkan/llama-server"]
CMD ["--help"]
